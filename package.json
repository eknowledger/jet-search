{
	"name": "jet-search",
	"version": "0.7.0",
	"description": "Fast search over your notes by name, text and properties, with scopes. Opens with Shift-Shift.",
	"main": "main.js",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"diagrams": "node docs/diagrams/render.mjs",
		"build": "node node_modules/typescript-7/bin/tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "node node_modules/typescript-7/bin/tsc -noEmit -skipLibCheck && node node_modules/typescript-7/bin/tsc -p bench -noEmit -skipLibCheck",
		"bench:engine": "node scripts/bench.mjs run",
		"bench:mem": "node scripts/bench.mjs mem",
		"bench:order": "node scripts/bench.mjs order",
		"format": "oxfmt src test bench vitest.config.mts",
		"format:check": "oxfmt --check src test bench vitest.config.mts",
		"lint": "oxlint src test bench vitest.config.mts && eslint src package.json",
		"lint:fix": "oxlint src test bench vitest.config.mts --fix && eslint src package.json --fix",
		"test": "vitest run --exclude 'test/{names,qa2-generate,excerpt,qa-search,stem,fixture-vaults}.test.ts' && npm run test:timed",
		"test:timed": "vitest run --no-file-parallelism test/names.test.ts test/qa2-generate.test.ts test/excerpt.test.ts test/qa-search.test.ts test/stem.test.ts test/fixture-vaults.test.ts",
		"test:watch": "vitest",
		"check": "npm run format:check && npm run lint && npm run typecheck && npm test"
	},
	"keywords": [
		"obsidian-plugin"
	],
	"author": "Ahmed Elmalt",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.15",
		"@sqlite.org/sqlite-wasm": "^3.53.4-build2",
		"@types/node": "^26.6.6",
		"esbuild": "^0.28.1",
		"eslint": "^10.8.0",
		"eslint-plugin-obsidianmd": "^0.6.0",
		"happy-dom": "^21.0.4",
		"obsidian": "^1.5.7",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"roughjs": "^4.6.6",
		"typescript": "^6.0.3",
		"typescript-7": "npm:typescript@^7.0.2",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.3.8",
		"vitest": "^4.1.10"
	}
}
